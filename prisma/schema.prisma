// ─────────────────────────────────────────────────────────────────────────────
// Prisma schema — Mini-ERP Almacén
// Multi-branch warehouse management with products, stock movements and expenses.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Branch (Sucursal) ───────────────────────────────────────────────────────
// A physical location. Seeded with 3 fixed branches.
model Branch {
  id        String   @id @default(cuid())
  code      String   @unique // stable short code, e.g. "CENTRO"
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  stockMovements StockMovement[]
  expenses       Expense[]

  @@map("branches")
}

// ─── Product ─────────────────────────────────────────────────────────────────
// A SKU is unique per branch (the same article can be tracked independently
// at each sucursal so stock levels and prices don't bleed across branches).
model Product {
  id               String   @id @default(cuid())
  branchId         String
  sku              String
  name             String
  description      String?
  unitPrice        Decimal  @db.Decimal(12, 2)
  stockQuantity    Int      @default(0)
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([branchId, sku])
  @@index([branchId])
  @@map("products")
}

// ─── StockMovement ───────────────────────────────────────────────────────────
// Immutable audit record. INBOUND increases stock, OUTBOUND decreases it,
// ADJUSTMENT records a correction (sign depends on the quantity semantics
// handled by the use case).
model StockMovement {
  id         String       @id @default(cuid())
  branchId   String
  productId  String
  type       MovementType
  quantity   Int
  unitCost   Decimal      @db.Decimal(12, 2)
  reason     String
  reference  String?
  occurredAt DateTime     @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([productId])
  @@index([occurredAt])
  @@map("stock_movements")
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

// ─── ExpenseCategory ─────────────────────────────────────────────────────────
// Seeded with 5 fixed categories: Alquiler, Servicios, Sueldos, Compra, Otros.
model ExpenseCategory {
  id        String   @id @default(cuid())
  code      String   @unique // stable code, e.g. "ALQUILER"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

// ─── Expense ─────────────────────────────────────────────────────────────────
model Expense {
  id          String   @id @default(cuid())
  branchId    String
  categoryId  String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([categoryId])
  @@index([incurredAt])
  @@map("expenses")
}
